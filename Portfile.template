# Tiramisu Port Recipe Template
# Place this file as 'Portfile' in your port's category directory (e.g. editors/myeditor/Portfile)

PORTNAME=       myapp
PORTVERSION=    1.0.0
CATEGORIES=     sysutils
MASTER_SITES=   https://github.com/example/myapp/releases/download/v${PORTVERSION}/
DISTFILES=      ${PORTNAME}-${PORTVERSION}.tar.gz

MAINTAINER=     developer@example.org
COMMENT=        Clean and efficient system utility for Tiramisu
WWW=            https://github.com/example/myapp

LICENSE=        BSD2CLAUSE
LICENSE_FILE=   ${WRKSRC}/LICENSE

# Dependencies
LIB_DEPENDS=    ncurses:devel/ncurses \
                zlib:devel/zlib
RUN_DEPENDS=    coreutils:sysutils/coreutils

# Compiler settings
# Target x86_64 FreeBSD 14 / Tiramisu ABI
CC?=            gcc
CFLAGS+=        -O2 -pipe -fno-strict-aliasing

do-build:
	@cd ${WRKSRC} && ${CC} ${CFLAGS} -o ${PORTNAME} main.c

do-install:
	@${INSTALL_PROGRAM} ${WRKSRC}/${PORTNAME} ${STAGEDIR}${PREFIX}/bin/${PORTNAME}
	@${INSTALL_MAN} ${WRKSRC}/${PORTNAME}.1 ${STAGEDIR}${PREFIX}/share/man/man1/
